# Existing Market Pulse configuration. Copy values locally; never commit secrets.
MONGODB_URI=
MONGODB_DB_NAME=market-pulse
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_FINNHUB_API_KEY=
GEMINI_API_KEY=
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Quant core: NSE archives, NSE calendar and Dhan master need no API keys.
# Relative paths resolve from the repository root, including in Task Scheduler.
QUANT_DATA_DIR=./data
QUANT_TIMEZONE=Asia/Kolkata
QUANT_HTTP_TIMEOUT_SECONDS=45
QUANT_HTTP_RETRIES=3
QUANT_NSE_REQUEST_INTERVAL_SECONDS=1.5
QUANT_NSE_BASE_URL=https://www.nseindia.com
QUANT_NSE_ARCHIVES_URL=https://nsearchives.nseindia.com
QUANT_NSE_USER_AGENT=Mozilla/5.0
QUANT_RBI_API_BASE=https://data-api.dbie.rbihub.in
QUANT_MONGO_PUBLISH=true

# Optional adapters run through update_all when enabled. Missing timing stays uncertain.
# Fundamentals also require a passing price audit. Derivatives remain unimplemented.
QUANT_ENABLE_FUNDAMENTALS=false
QUANT_ENABLE_SHAREHOLDING=false
QUANT_ENABLE_ANNOUNCEMENTS=false
QUANT_ENABLE_FIIDII=false
QUANT_ENABLE_RBI=false
QUANT_ENABLE_DERIVATIVES=false

# Optional live data. Never use NEXT_PUBLIC_ names for broker credentials.
QUANT_ENABLE_ANGEL=false
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
