# Existing Market Pulse configuration. Copy values locally; never commit secrets.
MONGODB_URI=
MONGODB_DB_NAME=market-pulse
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_FINNHUB_API_KEY=
GEMINI_API_KEY=
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Quant core: NSE archives, NSE calendar and Dhan master need no API keys.
# Relative paths resolve from the repository root, including in Task Scheduler.
QUANT_DATA_DIR=./data
QUANT_TIMEZONE=Asia/Kolkata
QUANT_HTTP_TIMEOUT_SECONDS=45
QUANT_HTTP_RETRIES=3
QUANT_NSE_REQUEST_INTERVAL_SECONDS=1.5
QUANT_NSE_BASE_URL=https://www.nseindia.com
QUANT_NSE_ARCHIVES_URL=https://nsearchives.nseindia.com
QUANT_NSE_USER_AGENT=Mozilla/5.0
QUANT_RBI_API_BASE=https://data-api.dbie.rbihub.in
QUANT_MONGO_PUBLISH=false
# Owner-only research status. Set the exact Better Auth account ID for reads.
QUANT_STATUS_OWNER_ID=
QUANT_STATUS_FILE=
QUANT_STATUS_SIGNING_KEY=
# Optional hosted status sync. Use a separate MongoDB role scoped to quant_status.
QUANT_STATUS_SYNC=false
QUANT_STATUS_SYNC_TOKEN=
QUANT_STATUS_MONGODB_URI=
QUANT_STATUS_MONGODB_DB=

# Optional adapters run through update_all when enabled. Missing timing stays uncertain.
# Fundamentals also require a passing price audit. Derivatives remain unimplemented.
QUANT_FETCH_FUNDAMENTALS=false
QUANT_FETCH_SHAREHOLDING=false
QUANT_FETCH_ANNOUNCEMENTS=false
QUANT_FETCH_FIIDII=false
QUANT_FETCH_RBI=false
QUANT_ENABLE_DERIVATIVES=false

# Optional live data. Never use NEXT_PUBLIC_ names for broker credentials.
QUANT_ENABLE_ANGEL=false
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Research V1 eligibility and execution assumptions; no publishing or trading.
QUANT_MIN_HISTORY_SESSIONS=252
QUANT_MIN_TRADING_PRESENCE=0.95
QUANT_MIN_ADV60=50000000
QUANT_MIN_PRICE=0
QUANT_BASE_SLIPPAGE_BPS=5
QUANT_BROKER_PROFILE=GENERIC_ZERO_DELIVERY

# Acquisition switches do not activate unvalidated model inputs.
QUANT_FETCH_LIFECYCLE=false
QUANT_MODEL_USE_FUNDAMENTALS=false
QUANT_MODEL_USE_OWNERSHIP=false
QUANT_MODEL_USE_MACRO=false
